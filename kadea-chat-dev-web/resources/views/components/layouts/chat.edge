<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Kadea Chat</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
  </head>
  <body class="h-dvh overflow-hidden bg-paper text-ink antialiased">
    {{{ await $slots.main() }}}

    <dialog id="new-chat" class="m-auto w-[min(92vw,460px)] rounded-3xl border-0 bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40">
      <div class="flex max-h-[80dvh] flex-col">
        <div class="flex items-center justify-between gap-3 px-5 pb-3 pt-5">
          <h2 class="text-lg font-medium">Nouvelle conversation</h2>
          <button type="button" data-close-new-chat aria-label="Fermer" class="grid size-9 place-items-center rounded-full text-muted hover:bg-panel">
            @svg('lucide:x', { width: 18, height: 18 })
          </button>
        </div>
        <div class="px-5 pb-3">
          <input
            type="search"
            data-user-search
            autocomplete="off"
            aria-label="Rechercher un utilisateur"
            placeholder="Rechercher un utilisateur"
            class="h-12 w-full rounded-full bg-panel px-5 text-base text-ink outline-none ring-1 ring-transparent focus:ring-2 focus:ring-accent"
          />
        </div>
        <div data-user-results class="flex-1 overflow-y-auto px-3 pb-4">
          <p class="px-2 py-6 text-center text-sm text-muted">Chargement…</p>
        </div>
        <p data-no-result style="display: none" class="px-5 pb-6 text-center text-sm text-muted">
          Aucun utilisateur ne correspond à ta recherche.
        </p>
      </div>
    </dialog>

    @include('partials/flash_alerts')
  </body>
</html>