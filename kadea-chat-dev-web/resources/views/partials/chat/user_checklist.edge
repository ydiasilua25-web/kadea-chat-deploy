@each(user in users)
  <label data-user data-search="{{ user.fullName }} {{ user.email }}" class="flex cursor-pointer items-center gap-3 rounded-2xl p-2 hover:bg-panel">
    <input type="checkbox" name="userIds[]" value="{{ user.id }}" class="size-5 shrink-0 accent-accent" />
    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent-ink">{{ user.initials }}</span>
    <span class="min-w-0 flex-1">
      <span class="block truncate font-medium">{{ user.fullName }}</span>
      <span class="block truncate text-sm text-muted">{{ user.email }}</span>
    </span>
  </label>
@end
@if(users.length === 0)
  <p class="px-2 py-6 text-center text-sm text-muted">Aucun autre utilisateur pour le moment.</p>
@end