@each(item in blockedUsers)
  <div class="flex items-center gap-3 rounded-2xl py-2">
    @if(item.avatarPath)
      <img src="{{ item.avatarPath }}" alt="" class="size-10 shrink-0 rounded-full object-cover" />
    @else
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent-ink">{{ item.initials }}</span>
    @end
    <span class="min-w-0 flex-1">
      <span class="block truncate text-[15px] font-medium">{{ item.name }}</span>
      <span class="block truncate text-xs text-muted">{{ item.email }}</span>
    </span>
    <form method="POST" action="/blocks/{{ item.userId }}/remove">
      {{ csrfField() }}
      <button type="submit" class="text-sm font-medium underline">Débloquer</button>
    </form>
  </div>
@end
@if(blockedUsers.length === 0)
  <p class="py-2 text-sm text-muted">Aucun utilisateur bloqué.</p>
@end