<nav
  aria-label="Navigation principale"
  class="{{ focus ? 'hidden md:flex' : 'flex' }} shrink-0 items-center justify-around gap-1 border-t border-line bg-panel px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] md:w-[72px] md:flex-col md:justify-start md:gap-3 md:border-r md:border-t-0 md:px-0 md:py-5"
>
  <a href="/chat" aria-label="Conversations" aria-current="page" class="grid size-11 place-items-center rounded-2xl bg-card text-ink shadow-sm">
    @svg('lucide:message-circle', { width: 22, height: 22 })
  </a>
  <a href="/chat/new" data-open-new-chat aria-label="Nouvelle conversation" class="grid size-11 place-items-center rounded-2xl text-muted transition hover:bg-card hover:text-ink">
    @svg('lucide:plus', { width: 22, height: 22 })
  </a>
  <button type="button" data-soon="La création de groupe arrive à l’étape suivante." aria-label="Nouveau groupe" class="grid size-11 place-items-center rounded-2xl text-muted transition hover:bg-card hover:text-ink">
    @svg('lucide:users', { width: 22, height: 22 })
  </button>
  <button type="button" data-soon="Les appels arrivent bientôt." aria-label="Appels" class="grid size-11 place-items-center rounded-2xl text-muted transition hover:bg-card hover:text-ink">
    @svg('lucide:phone', { width: 22, height: 22 })
  </button>
  <button type="button" data-open="profile-dialog" aria-label="Mon profil" class="grid size-11 place-items-center rounded-full bg-accent-soft text-sm font-semibold text-accent-ink md:mt-auto">{{ me.initials }}</button>
</nav>