<aside data-chat-me="{{ me.id }}" class="{{ focus ? 'hidden md:flex' : 'flex' }} h-full min-h-0 w-full flex-col border-r border-line bg-card md:w-[340px] md:shrink-0">
  <div class="px-5 pb-3 pt-5">
    <div class="flex items-center justify-between gap-3">
      <a href="/chat" aria-label="Kadea Chat, accueil">
        @!logo()
      </a>
      @!themeToggle()
    </div>
    <h2 class="mt-3 text-xl font-medium tracking-tight">Conversations</h2>

    <div class="mt-3 flex items-center gap-2 rounded-full bg-panel px-4 text-muted focus-within:ring-2 focus-within:ring-accent">
      @svg('lucide:search', { width: 16, height: 16 })
      <input
        type="search"
        data-conversation-search
        autocomplete="off"
        aria-label="Rechercher une conversation"
        placeholder="Rechercher une conversation"
        class="h-11 min-w-0 flex-1 appearance-none bg-transparent text-base text-ink outline-none placeholder:text-subtle"
      />
    </div>
  </div>

  <p data-conversation-empty style="display: none" class="px-5 pb-4 text-center text-sm text-muted">
    Aucune conversation ne correspond à ta recherche.
  </p>

  <nav id="conversation-list" class="min-h-0 flex-1 overflow-y-auto" aria-label="Conversations">
    @include('partials/chat/conversation_list')
  </nav>
</aside>