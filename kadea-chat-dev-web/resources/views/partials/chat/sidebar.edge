<aside data-chat-me="{{ me.id }}" class="{{ focus ? 'hidden md:flex' : 'flex' }} h-dvh w-full flex-col border-r border-line bg-card md:w-[340px] md:shrink-0">
  <div class="flex items-center justify-between gap-2 px-5 pb-3 pt-5">
    <a href="/chat" class="text-xl font-medium tracking-tight">Conversations</a>
    <div class="flex items-center gap-2">
      @!themeToggle()
      <a href="/chat/new" data-open-new-chat aria-label="Nouvelle conversation" class="grid size-10 place-items-center rounded-full bg-pine text-pine-fg">
       @svg('lucide:plus', { width: 18, height: 18 })
      </a>
      <form method="POST" action="/logout">
        {{ csrfField() }}
        <button type="submit" aria-label="Se déconnecter" class="grid size-10 place-items-center rounded-full text-muted hover:bg-panel">
          @svg('lucide:log-out', { width: 18, height: 18 })
        </button>
      </form>
    </div>
  </div>

  <nav id="conversation-list" class="flex-1 overflow-y-auto" aria-label="Conversations">
    @include('partials/chat/conversation_list')
  </nav>
</aside>