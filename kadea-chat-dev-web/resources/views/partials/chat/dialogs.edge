{{-- Nouvelle conversation --}}
<dialog id="new-chat" class="m-auto w-[min(92vw,460px)] rounded-3xl border-0 bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40">
  <div class="flex max-h-[80dvh] flex-col">
    <div class="flex items-center justify-between gap-3 px-5 pb-3 pt-5">
      <h2 class="text-lg font-medium">Nouvelle conversation</h2>
      <button type="button" data-close aria-label="Fermer" class="grid size-9 place-items-center rounded-full text-muted hover:bg-panel">
        @svg('lucide:x', { width: 18, height: 18 })
      </button>
    </div>
    <div class="px-5 pb-3">
      <input
        type="search"
        data-user-search
        autocomplete="off"
        aria-label="Rechercher un utilisateur"
        placeholder="Rechercher un utilisateur"
        class="h-12 w-full rounded-full bg-panel px-5 text-base text-ink outline-none ring-1 ring-transparent focus:ring-2 focus:ring-accent"
      />
    </div>
    <div data-user-results class="flex-1 overflow-y-auto px-3 pb-4">
      <p class="px-2 py-6 text-center text-sm text-muted">Chargement…</p>
    </div>
    <p data-no-result style="display: none" class="px-5 pb-6 text-center text-sm text-muted">
      Aucun utilisateur ne correspond à ta recherche.
    </p>
  </div>
</dialog>

{{-- Profil --}}
<dialog id="profile-dialog" class="m-auto w-[min(92vw,460px)] rounded-3xl border-0 bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40">
  <div class="max-h-[88dvh] overflow-y-auto" x-data="{ pwd: false }">
    <div class="flex items-center justify-between px-5 pt-5">
      <h2 class="text-lg font-medium">Profil</h2>
      <button type="button" data-close aria-label="Fermer" class="grid size-9 place-items-center rounded-full text-muted hover:bg-panel">
        @svg('lucide:x', { width: 18, height: 18 })
      </button>
    </div>

    <div class="flex flex-col items-center gap-1 px-5 py-6 text-center">
      <span class="mb-2 grid size-24 place-items-center rounded-full bg-accent-soft text-3xl font-semibold text-accent-ink">{{ me.initials }}</span>
      <p class="text-lg font-medium">{{ me.fullName }}</p>
      <p class="text-sm text-muted">{{ me.email }}</p>
      <p class="mt-1 text-xs text-subtle">Membre depuis le {{ me.createdAt.toFormat('dd/MM/yyyy') }}</p>
    </div>

    <form method="POST" action="/profile/name" class="grid gap-2 border-t border-line px-5 py-4">
      {{ csrfField() }}
      <label for="profile-name" class="text-sm text-muted">Nom</label>
      <div class="flex gap-2">
        <input id="profile-name" name="fullName" value="{{ me.fullName }}" required minlength="2" maxlength="100" class="h-11 min-w-0 flex-1 rounded-full bg-panel px-4 text-base outline-none focus:ring-2 focus:ring-accent" />
        <button type="submit" class="lp-btn lp-btn--soft h-11">Enregistrer</button>
      </div>
    </form>

    <div class="border-t border-line px-5 py-4">
      <button type="button" x-on:click="pwd = !pwd" class="flex w-full items-center justify-between text-left text-sm font-medium">
        Changer le mot de passe
        <span x-bind:class="pwd && 'rotate-180'">
          @svg('lucide:arrow-down', { width: 16, height: 16 })
        </span>
      </button>
      <form x-show="pwd" x-cloak method="POST" action="/profile/password" class="mt-3 grid gap-3">
        {{ csrfField() }}
        <input type="password" name="currentPassword" required autocomplete="current-password" placeholder="Mot de passe actuel" class="h-11 rounded-full bg-panel px-4 text-base outline-none focus:ring-2 focus:ring-accent" />
        <input type="password" name="password" required minlength="8" maxlength="32" autocomplete="new-password" placeholder="Nouveau mot de passe" class="h-11 rounded-full bg-panel px-4 text-base outline-none focus:ring-2 focus:ring-accent" />
        <input type="password" name="passwordConfirmation" required autocomplete="new-password" placeholder="Confirme le nouveau mot de passe" class="h-11 rounded-full bg-panel px-4 text-base outline-none focus:ring-2 focus:ring-accent" />
        <button type="submit" class="lp-btn h-11 justify-center">Changer le mot de passe</button>
      </form>
    </div>

    <div class="border-t border-line px-5 py-4">
      <button type="button" data-open="logout-dialog" class="flex w-full items-center gap-3 text-left text-sm font-medium" style="color: #d64545">
        @svg('lucide:log-out', { width: 18, height: 18 })
        Se déconnecter
      </button>
    </div>
  </div>
</dialog>

{{-- Confirmation de déconnexion --}}
<dialog id="logout-dialog" class="m-auto w-[min(92vw,380px)] rounded-3xl border-0 bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40">
  <div class="p-6 text-center">
    <h2 class="text-lg font-medium">Voulez-vous vous déconnecter ?</h2>
    <p class="mt-2 text-sm text-muted">Tu devras te reconnecter pour retrouver tes conversations.</p>
    <div class="mt-6 grid grid-cols-2 gap-3">
      <button type="button" data-close class="lp-btn lp-btn--soft h-12 justify-center">Annuler</button>
      <form method="POST" action="/logout">
        {{ csrfField() }}
        <button type="submit" class="lp-btn h-12 w-full justify-center">Confirmer</button>
      </form>
    </div>
  </div>
</dialog>

{{-- Nouveau groupe --}}
<dialog id="new-group" class="m-auto w-[min(92vw,460px)] rounded-3xl border-0 bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40">
  <form method="POST" action="/groups" data-reset class="flex max-h-[85dvh] flex-col">
    {{ csrfField() }}
    <div class="flex items-center justify-between gap-3 px-5 pb-3 pt-5">
      <h2 class="text-lg font-medium">Nouveau groupe</h2>
      <button type="button" data-close aria-label="Fermer" class="grid size-9 place-items-center rounded-full text-muted hover:bg-panel">
        @svg('lucide:x', { width: 18, height: 18 })
      </button>
    </div>
    <div class="px-5 pb-2">
      <input
        name="name"
        required
        minlength="2"
        maxlength="60"
        autocomplete="off"
        aria-label="Nom du groupe"
        placeholder="Nom du groupe"
        class="h-12 w-full rounded-full bg-panel px-5 text-base text-ink outline-none focus:ring-2 focus:ring-accent"
      />
    </div>
    <div class="px-5 pb-2">
      <input
        type="search"
        data-user-search
        x-data
        x-on:keydown.enter.prevent
        autocomplete="off"
        aria-label="Rechercher des membres"
        placeholder="Rechercher des membres"
        class="h-12 w-full rounded-full bg-panel px-5 text-base text-ink outline-none focus:ring-2 focus:ring-accent"
      />
    </div>
    <div data-user-results class="min-h-0 flex-1 overflow-y-auto px-3">
      <p class="px-2 py-6 text-center text-sm text-muted">Chargement…</p>
    </div>
    <p data-no-result style="display: none" class="px-5 pb-3 text-center text-sm text-muted">
      Aucun utilisateur ne correspond à ta recherche.
    </p>
    <div class="p-4">
      <button type="submit" class="lp-btn h-12 w-full justify-center">Créer le groupe</button>
    </div>
  </form>
</dialog>