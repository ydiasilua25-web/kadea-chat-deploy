<dialog id="group-info" class="m-auto w-[min(92vw,460px)] rounded-3xl border-0 bg-card p-0 text-ink shadow-2xl backdrop:bg-black/40">
  <div class="max-h-[88dvh] overflow-y-auto" x-data="{ adding: false }">
    <div class="flex items-center justify-between px-5 pt-5">
      <h2 class="text-lg font-medium">Infos du groupe</h2>
      <button type="button" data-close aria-label="Fermer" class="grid size-9 place-items-center rounded-full text-muted hover:bg-panel">
        @svg('lucide:x', { width: 18, height: 18 })
      </button>
    </div>

    <div class="flex flex-col items-center gap-1 px-5 py-5 text-center">
      <span class="mb-2 grid size-20 place-items-center rounded-full bg-accent-soft text-2xl font-semibold text-accent-ink">{{ current.initials }}</span>
      <p class="text-lg font-medium">{{ current.title }}</p>
      <p class="text-sm text-muted">{{ members.length }} membres</p>
    </div>

    <div class="border-t border-line px-3 py-3">
      @each(member in members)
        <div class="flex items-center gap-3 rounded-2xl px-2 py-2">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent-ink">{{ member.initials }}</span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-[15px] font-medium">{{ member.name }}</span>
            <span class="block truncate text-xs text-muted">{{ member.email }}</span>
          </span>
          @if(member.isAdmin)
            <span class="rounded-full bg-pine px-2.5 py-0.5 text-xs text-pine-fg">Admin</span>
          @end
          @if(iAmAdmin && !member.isAdmin)
            <form method="POST" action="/chat/{{ current.id }}/members/{{ member.userId }}/remove">
              {{ csrfField() }}
              <button type="submit" class="text-sm font-medium" style="color: #d64545">Retirer</button>
            </form>
          @end
        </div>
      @end
    </div>

    @if(iAmAdmin)
      <div class="border-t border-line px-5 py-4">
        <button type="button" x-on:click="adding = !adding" class="flex w-full items-center justify-between text-left text-sm font-medium">
          Ajouter des membres
          <span x-bind:class="adding && 'rotate-180'">
            @svg('lucide:arrow-down', { width: 16, height: 16 })
          </span>
        </button>

        <form x-show="adding" x-cloak method="POST" action="/chat/{{ current.id }}/members" class="mt-3">
          {{ csrfField() }}
          <div class="max-h-56 overflow-y-auto">
            @each(user in candidates)
              <label class="flex cursor-pointer items-center gap-3 rounded-2xl p-2 hover:bg-panel">
                <input type="checkbox" name="userIds[]" value="{{ user.id }}" class="size-5 shrink-0 accent-accent" />
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium">{{ user.fullName }}</span>
                  <span class="block truncate text-sm text-muted">{{ user.email }}</span>
                </span>
              </label>
            @end
            @if(candidates.length === 0)
              <p class="px-2 py-4 text-center text-sm text-muted">Tout le monde est déjà dans ce groupe.</p>
            @end
          </div>
          <button type="submit" class="lp-btn mt-3 h-11 w-full justify-center">Ajouter</button>
        </form>
      </div>
    @end
  </div>
</dialog>