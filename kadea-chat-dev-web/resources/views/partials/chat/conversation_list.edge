@if(conversations.length === 0)
  <p class="px-5 py-8 text-sm text-muted">Aucune conversation pour le moment. Utilise le bouton + pour écrire à quelqu’un.</p>
@end
@each(item in conversations)
  <a href="/chat/{{ item.id }}" data-conv data-search="{{ item.title }} {{ item.preview }}" class="flex items-center gap-3 px-5 py-3 transition hover:bg-panel {{ item.id === currentId ? 'bg-panel' : '' }}">
    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent-soft text-sm font-semibold text-accent-ink">{{ item.initials }}</span>
    <span class="min-w-0 flex-1">
      <span class="block truncate {{ item.unread > 0 && item.id !== currentId ? 'font-semibold' : 'font-medium' }}">{{ item.title }}</span>
      <span class="block truncate text-sm {{ item.deleted ? 'italic' : '' }} {{ item.unread > 0 && item.id !== currentId ? 'text-ink' : 'text-muted' }}">{{ item.preview }}</span>
    </span>
    <span class="flex flex-col items-end gap-1">
      <span class="text-xs {{ item.unread > 0 && item.id !== currentId ? 'font-semibold text-accent-ink' : 'text-subtle' }}">{{ item.time }}</span>
      @if(item.unread > 0 && item.id !== currentId)
        <span class="min-w-5 rounded-full bg-pine px-1.5 text-center text-xs font-semibold text-pine-fg">{{ item.unread > 99 ? '99+' : item.unread }}</span>
      @end
    </span>
  </a>
@end