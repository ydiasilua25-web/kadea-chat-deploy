@layouts.auth()
  <h1 class="auth__title">Mot de passe oublié</h1>
  <p class="auth__sub">Entre ton adresse e-mail : nous t'enverrons un lien pour choisir un nouveau mot de passe.</p>

  @if(flashMessages.has('success'))
    <p style="color: #15803d;">{{ flashMessages.get('success') }}</p>
  @end
  @if(flashMessages.has('error'))
    <p style="color: #b91c1c;">{{ flashMessages.get('error') }}</p>
  @end

  @form({ route: 'forgot_password.store', method: 'POST', class: 'auth__form' })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({ type: 'email', autocomplete: 'email', placeholder: 'you@example.com' })
      @!field.error()
    @end
    @!button({ text: 'Envoyer le lien', type: 'submit', block: true })
  @end

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Retour à la connexion
    @end
  </p>
@end