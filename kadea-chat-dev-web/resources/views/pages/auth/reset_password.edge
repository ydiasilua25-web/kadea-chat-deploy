@layouts.auth()
  <h1 class="auth__title">Nouveau mot de passe</h1>
  <p class="auth__sub">Choisis un mot de passe d'au moins 8 caractères.</p>

  @form({ route: 'reset_password.store', method: 'POST', class: 'auth__form' })
    <input type="hidden" name="token" value="{{ token }}">
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirme le mot de passe' })
      @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
      @!field.error()
    @end
    @!button({ text: 'Changer le mot de passe', type: 'submit', block: true })
  @end
@end