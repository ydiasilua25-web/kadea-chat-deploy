@layouts.chat()
  <div class="flex h-dvh w-full flex-col-reverse md:flex-row">
    @include('partials/chat/rail')

    <div class="flex min-h-0 min-w-0 flex-1">
      @include('partials/chat/sidebar')

      <main class="hidden min-h-0 min-w-0 flex-1 flex-col items-center justify-center gap-3 bg-paper px-6 text-center md:flex">
        <span class="grid size-16 place-items-center rounded-2xl bg-panel text-muted">
          @svg('lucide:message-circle', { width: 28, height: 28 })
        </span>
        <h1 class="text-2xl font-medium tracking-tight">Choisis une conversation</h1>
        <p class="max-w-sm text-muted">Ouvre une discussion dans la liste, ou démarre-en une nouvelle avec le bouton +.</p>
      </main>
    </div>
  </div>

  @include('partials/chat/dialogs')
@end