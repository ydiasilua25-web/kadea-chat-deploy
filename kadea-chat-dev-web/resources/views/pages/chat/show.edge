@layouts.chat()
  <div class="flex h-dvh w-full">
    @include('partials/chat/sidebar')

    <main class="flex min-w-0 flex-1 flex-col bg-paper">
      <header class="flex items-center gap-3 border-b border-line bg-card px-4 py-3 md:px-6">
        <a href="/chat" aria-label="Retour aux conversations" class="grid size-10 place-items-center rounded-full text-muted hover:bg-panel md:hidden">
          @svg('lucide:arrow-left', { width: 20, height: 20 })
        </a>
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-sm font-semibold text-accent-ink">{{ current.initials }}</span>
        <p class="truncate font-medium">{{ current.title }}</p>
      </header>

      <div id="messages" x-data x-init="$el.scrollTop = $el.scrollHeight" class="flex flex-1 flex-col gap-3 overflow-y-auto px-4 py-6 md:px-8">
        @if(messages.length === 0)
          <p class="m-auto text-sm text-muted">Aucun message. Écris le premier !</p>
        @end

        @each(message in messages)
          @if(message.userId === me.id)
            <div class="flex max-w-[85%] flex-col items-end gap-1 self-end md:max-w-[65%]">
              @if(message.isDeleted)
                <p class="rounded-2xl border border-dashed border-line-2 px-4 py-2.5 text-sm italic text-muted">Ce message a été supprimé</p>
              @else
                <p class="whitespace-pre-wrap break-words rounded-2xl rounded-br-md bg-pine px-4 py-2.5 text-pine-fg">{{ message.content }}</p>
              @end
              <div class="flex items-center gap-3 px-1 text-xs text-subtle">
                <span>{{ message.time }}</span>
                @if(!message.isDeleted)
                  <form method="POST" action="/chat/{{ current.id }}/messages/{{ message.id }}/delete">
                    {{ csrfField() }}
                    <button type="submit" class="underline hover:text-ink">Supprimer</button>
                  </form>
                @end
              </div>
            </div>
          @else
            <div class="flex max-w-[85%] flex-col gap-1 self-start md:max-w-[65%]">
              @if(current.isGroup)
                <span class="px-1 text-xs text-muted">{{ message.authorName }}</span>
              @end
              @if(message.isDeleted)
                <p class="rounded-2xl border border-dashed border-line-2 px-4 py-2.5 text-sm italic text-muted">Ce message a été supprimé</p>
              @else
                <p class="whitespace-pre-wrap break-words rounded-2xl rounded-bl-md bg-card px-4 py-2.5 shadow-sm">{{ message.content }}</p>
              @end
              <span class="px-1 text-xs text-subtle">{{ message.time }}</span>
            </div>
          @end
        @end
      </div>

      <form method="POST" action="/chat/{{ current.id }}/messages" class="flex items-center gap-3 px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] md:px-6">
        {{ csrfField() }}
        <input
          type="text"
          name="content"
          required
          maxlength="2000"
          autocomplete="off"
          aria-label="Écrire un message"
          placeholder="Écrire un message…"
          class="h-12 min-w-0 flex-1 rounded-full bg-card px-5 text-base outline-none ring-1 ring-line-2 focus:ring-2 focus:ring-accent"
        />
        <button type="submit" aria-label="Envoyer" class="grid size-12 shrink-0 place-items-center rounded-full bg-pine text-pine-fg">
          @svg('lucide:send', { width: 18, height: 18 })
        </button>
      </form>
    </main>
  </div>
@end