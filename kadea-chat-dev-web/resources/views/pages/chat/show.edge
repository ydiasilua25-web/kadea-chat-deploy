@layouts.chat()
  <div class="flex h-dvh w-full">
    @include('partials/chat/sidebar')

    <main class="flex min-w-0 flex-1 flex-col bg-paper">
      <header class="flex items-center gap-3 border-b border-line bg-card px-4 py-3 md:px-6">
        <a href="/chat" aria-label="Retour aux conversations" class="grid size-10 place-items-center rounded-full text-muted hover:bg-panel md:hidden">
          @svg('lucide:arrow-left', { width: 20, height: 20 })
        </a>
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-sm font-semibold text-accent-ink">{{ current.initials }}</span>
        <p class="truncate font-medium">{{ current.title }}</p>
      </header>

      <div id="messages" data-conversation-id="{{ current.id }}" x-data x-init="$el.scrollTop = $el.scrollHeight" class="flex flex-1 flex-col gap-3 overflow-y-auto px-4 py-6 md:px-8">
        @if(!hasMessages)
          <p data-empty class="m-auto text-sm text-muted">Aucun message. Écris le premier !</p>
        @end
        {{{ messagesHtml }}}
      </div>

      <form method="POST" action="/chat/{{ current.id }}/messages" data-fetch data-composer class="flex items-center gap-3 px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] md:px-6">
        {{ csrfField() }}
        <input
          type="text"
          name="content"
          required
          maxlength="2000"
          autocomplete="off"
          aria-label="Écrire un message"
          placeholder="Écrire un message…"
          class="h-12 min-w-0 flex-1 rounded-full bg-card px-5 text-base outline-none ring-1 ring-line-2 focus:ring-2 focus:ring-accent"
        />
        <button type="submit" aria-label="Envoyer" class="grid size-12 shrink-0 place-items-center rounded-full bg-pine text-pine-fg disabled:opacity-50">
          @svg('lucide:send', { width: 18, height: 18 })
        </button>
      </form>
    </main>
  </div>
@end