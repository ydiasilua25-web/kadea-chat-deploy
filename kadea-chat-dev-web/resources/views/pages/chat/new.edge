          <a href="/chat" aria-label="Retour aux conversations" class="grid size-10 place-items-center rounded-full text-muted hover:bg-panel md:hidden">
            @svg('lucide:arrow-left', { width: 20, height: 20 })
          </a>
          <h1 class="text-lg font-medium">Nouvelle conversation</h1>
