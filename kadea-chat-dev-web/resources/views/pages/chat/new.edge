              class="h-12 min-w-0 flex-1 rounded-full bg-card px-5 text-base outline-none ring-1 ring-line-2 focus:ring-2 focus:ring-accent"
            />
            <button type="submit" class="lp-btn h-12">Chercher</button>
          </form>

          <div class="mt-6">
            @include('partials/chat/user_list')
          </div>
        </div>
