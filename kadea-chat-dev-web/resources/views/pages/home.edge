@layouts.landing()

  {{-- ===== Hero ===== --}}
  <section class="mx-auto grid max-w-[1180px] items-center gap-10 px-6 pb-20 pt-12 md:px-10 lg:grid-cols-[1.05fr_1fr] lg:pt-20">
    <div>
      <h1 class="text-balance text-[44px] font-medium leading-[1.02] tracking-[-0.03em] sm:text-[60px] lg:text-[72px]">
        <span class="block text-subtle">Discuter simplement,</span>
        <span class="block">Rester connectés</span>
      </h1>
      <p class="mt-7 max-w-[34rem] text-lg leading-relaxed text-muted">
        Kadea Chat réunit les apprenants de l’académie : messages privés, groupes de travail et historique retrouvé à chaque connexion, directement dans le navigateur.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-5">
        <a class="lp-btn" href="/signup">
          Créer un compte
          @svg('lucide:arrow-right', { width: 16, height: 16 })
        </a>
        <div class="flex items-center gap-3 text-sm text-muted">
          <span class="flex -space-x-2">
            @each(initials in ['AM', 'JK', 'GM', 'EK'])
              <span class="grid size-8 place-items-center rounded-full border-2 border-paper bg-accent-soft text-[11px] font-semibold text-accent-ink">{{ initials }}</span>
            @end
          </span>
          Privé ou en groupe, en temps réel
        </div>
      </div>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-[620px]">
      <canvas data-sphere class="absolute inset-0 size-full cursor-grab touch-pan-y active:cursor-grabbing" aria-hidden="true"></canvas>
      <span class="lp-label pointer-events-none absolute bottom-0 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full bg-card/80 px-4 py-2 backdrop-blur">
        <i class="size-2 rounded-full bg-accent"></i>
        Faites glisser pour faire tourner
      </span>
    </div>
  </section>

  {{-- ===== Fonctionnalités ===== --}}
  <section id="fonctionnalites" class="mx-auto max-w-[1180px] px-6 py-16 md:px-10">
    <div class="grid gap-6 lg:grid-cols-2">

      <div class="rounded-[28px] border border-line bg-panel p-7">
        <ul class="grid gap-2 text-[15px] text-muted">
          <li class="flex items-center gap-3"><i class="size-1.5 rounded-full bg-subtle"></i> Messages privés avec n’importe quel utilisateur</li>
          <li class="flex items-center gap-3"><i class="size-1.5 rounded-full bg-subtle"></i> Historique conservé à chaque connexion</li>
          <li class="flex items-center gap-3"><i class="size-1.5 rounded-full bg-subtle"></i> Accès réservé aux membres de la conversation</li>
        </ul>
        <div class="mt-8 flex flex-col gap-3 rounded-2xl bg-card/70 p-5">
          <p class="lp-label">Conversation privée</p>
          <p class="max-w-[80%] self-start rounded-2xl rounded-bl-md bg-card px-4 py-2.5 text-sm shadow-sm">Tu as fini les migrations ?</p>
          <p class="max-w-[80%] self-end rounded-2xl rounded-br-md bg-pine px-4 py-2.5 text-sm text-pine-fg">Oui, les 7 tables sont créées.</p>
          <p class="self-end text-xs text-accent-ink">Lu</p>
        </div>
        <p class="mt-6 text-[15px]">Chaque échange, retrouvé tel que tu l’as laissé</p>
      </div>

      <div class="rounded-[28px] border border-line bg-panel p-7">
        <ul class="grid gap-2 text-[15px] text-muted">
          <li class="flex items-center gap-3"><i class="size-1.5 rounded-full bg-subtle"></i> Un administrateur par groupe</li>
          <li class="flex items-center gap-3"><i class="size-1.5 rounded-full bg-subtle"></i> Ajout et retrait de membres</li>
          <li class="flex items-center gap-3"><i class="size-1.5 rounded-full bg-subtle"></i> Les messages supprimés sont signalés</li>
        </ul>
        <div class="relative mx-auto mt-8 h-[250px] w-[250px]">
          <span class="absolute left-1/2 top-1/2 grid size-[84px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-pine text-lg font-semibold text-pine-fg">PD</span>
          @each((member, index) in ['AM', 'JK', 'GM', 'EK', 'NL', 'SP'])
            <span
              class="absolute left-1/2 top-1/2 grid size-11 place-items-center rounded-full border border-line-2 bg-card text-xs font-semibold text-muted"
              style="transform: translate(-50%, -50%) rotate({{ index * 60 }}deg) translate(100px) rotate(-{{ index * 60 }}deg);"
            >{{ member }}</span>
          @end
        </div>
        <p class="mt-6 text-[15px]">Groupe de travail <span class="lp-label ml-2">12 membres</span></p>
      </div>

      <div class="rounded-[28px] bg-card p-7" x-data="{ members: 12, perDay: 15 }">
        <div class="flex flex-wrap items-center gap-4">
          <span class="text-muted">Ton groupe réunit</span>
          <div class="flex gap-1 rounded-xl bg-panel p-1">
            @each(n in [5, 12, 30])
              <button type="button" class="rounded-lg px-4 py-1.5 text-sm" x-on:click="members = {{ n }}" x-bind:class="members === {{ n }} ? 'bg-card text-ink shadow-sm' : 'text-muted'">{{ n }} personnes</button>
            @end
          </div>
        </div>
        <div class="mt-6 flex items-center gap-4 text-sm text-muted">
          <span class="w-28 shrink-0">Messages par personne</span>
          <input type="range" min="1" max="40" x-model.number="perDay" class="w-full accent-accent" aria-label="Messages par personne et par jour" />
          <span class="w-20 shrink-0 text-right text-ink" x-text="perDay + ' par jour'"></span>
        </div>
        <div class="mt-6 border-t border-dashed border-line-2 pt-6">
          <p class="text-4xl font-medium tracking-tight" x-text="(members * perDay).toLocaleString('fr-FR')"></p>
          <p class="mt-2 text-sm text-muted">messages par jour, tous conservés dans l’historique. Estimation indicative.</p>
        </div>
      </div>

      <div class="rounded-[28px] bg-card p-7" x-data="{ size: 8 }">
        <div class="flex items-center gap-4 text-sm text-muted">
          <span class="w-28 shrink-0">Tu invites</span>
          <input type="range" min="2" max="50" x-model.number="size" class="w-full accent-accent" aria-label="Nombre de membres du groupe" />
          <span class="w-24 shrink-0 text-right text-ink" x-text="size + ' membres'"></span>
        </div>
        <div class="mt-6 border-t border-dashed border-line-2 pt-6">
          <p class="text-4xl font-medium tracking-tight" x-text="size + ' personnes'"></p>
          <p class="mt-2 text-sm text-muted" x-text="'1 administrateur et ' + (size - 1) + ' membres, ajoutés ou retirés à tout moment.'"></p>
        </div>
      </div>

    </div>
  </section>

  {{-- ===== Comment ça marche ===== --}}
  <section id="comment-ca-marche" class="mx-auto max-w-[1180px] px-6 py-16 md:px-10">
    <h2 class="text-[40px] font-medium tracking-[-0.02em] sm:text-5xl">Comment ça marche</h2>

    <div class="mt-12 grid gap-8 lg:grid-cols-3">

      <div>
        <h3 class="text-xl font-medium">Crée ton compte</h3>
        <div class="relative mt-5 grid h-[300px] place-items-center overflow-hidden rounded-[28px] border border-line bg-panel [background-image:radial-gradient(var(--line-2)_1px,transparent_1px)] [background-size:16px_16px]">
          <div class="w-[78%] rounded-2xl bg-card p-4 shadow-[0_14px_30px_-18px_rgba(0,0,0,0.35)]">
            <p class="lp-label">Étape 1 sur 3</p>
            <div class="mt-3 rounded-xl border border-line-2 px-3 py-2 text-sm text-muted">Ton adresse e-mail</div>
          </div>
          <span class="absolute bottom-12 rounded-lg bg-card px-4 py-2 text-sm shadow-sm">Créer mon compte</span>
        </div>
        <p class="mt-5 text-muted">Un nom, une adresse e-mail et un mot de passe suffisent pour commencer.</p>
      </div>

      <div>
        <h3 class="text-xl font-medium">Confirme ton adresse</h3>
        <div class="relative mt-5 grid h-[300px] place-items-center overflow-hidden rounded-[28px] border border-line bg-panel [background-image:radial-gradient(var(--line-2)_1px,transparent_1px)] [background-size:16px_16px]">
          <span class="absolute h-[120px] w-[66%] -translate-x-5 -translate-y-6 rounded-2xl bg-ink/80"></span>
          <span class="absolute h-[120px] w-[66%] -translate-x-2.5 -translate-y-3 rounded-2xl bg-ink/90"></span>
          <div class="relative w-[66%] rounded-2xl bg-card p-4 shadow-[0_14px_30px_-18px_rgba(0,0,0,0.4)]">
            <p class="lp-label">E-mail de confirmation</p>
            <p class="mt-2 text-sm font-medium">Bienvenue sur Kadea Chat</p>
            <span class="lp-label absolute -bottom-3 right-3 -rotate-6 rounded-lg border-2 border-accent bg-accent-soft px-3 py-1 !text-accent-ink">Confirmé</span>
          </div>
        </div>
        <p class="mt-5 text-muted">Tu reçois un e-mail avec un lien : un clic, et ton compte est actif.</p>
      </div>

      <div>
        <h3 class="text-xl font-medium">Commence à discuter</h3>
        <div class="relative mt-5 grid h-[300px] place-items-center overflow-hidden rounded-[28px] border border-line bg-panel [background-image:radial-gradient(var(--line-2)_1px,transparent_1px)] [background-size:16px_16px]">
          <span class="absolute top-[58px] right-[18%] rounded-lg bg-pine px-3 py-1 text-xs text-pine-fg">Message reçu</span>
          <div class="w-[78%] rounded-2xl bg-card p-4 shadow-[0_14px_30px_-18px_rgba(0,0,0,0.35)]">
            <div class="flex items-center gap-3">
              <span class="grid size-9 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-accent-ink">GM</span>
              <div class="text-sm"><p class="font-medium">Grace Mbuyi</p><p class="text-xs text-muted">Écrit…</p></div>
            </div>
          </div>
          <span class="absolute bottom-[88px] h-1.5 w-[78%] rounded-full bg-line-2"><i class="block h-full w-1/2 rounded-full bg-accent"></i></span>
          <span class="absolute bottom-10 rounded-lg bg-ink/70 px-4 py-2 text-sm text-paper">Message envoyé</span>
        </div>
        <p class="mt-5 text-muted">Écris à un camarade ou crée un groupe : les messages arrivent sans recharger la page.</p>
      </div>

    </div>
  </section>

  {{-- ===== Cas d'usage ===== --}}
  <section class="mx-auto max-w-[1180px] px-6 py-16 md:px-10" x-data>
    <div class="flex items-end justify-between gap-6">
      <h2 class="text-[40px] font-medium tracking-[-0.02em] sm:text-5xl">Cas d’usage</h2>
      <div class="flex gap-2">
        <button type="button" aria-label="Précédent" class="grid size-11 place-items-center rounded-xl bg-card text-muted shadow-sm" x-on:click="$refs.track.scrollBy({ left: -440, behavior: 'smooth' })">@svg('lucide:arrow-left', { width: 18, height: 18 })</button>
        <button type="button" aria-label="Suivant" class="grid size-11 place-items-center rounded-xl bg-card shadow-sm" x-on:click="$refs.track.scrollBy({ left: 440, behavior: 'smooth' })">@svg('lucide:arrow-right', { width: 18, height: 18 })</button>
      </div>
    </div>

    <div x-ref="track" class="mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 [scrollbar-width:none]">
      @each(card in [
        { title: 'Réviser en groupe', tag: 'Groupe', text: 'Un groupe par promotion ou par projet, avec un administrateur qui gère les membres.' },
        { title: 'S’entraider', tag: 'Privé', text: 'Un message direct, sans quitter le navigateur, et l’historique retrouvé à la reconnexion.' },
        { title: 'Avancer sur un projet', tag: 'Temps réel', text: 'Les messages arrivent immédiatement chez tous les membres, sans rien actualiser.' }
      ])
        <article class="w-[min(86vw,420px)] shrink-0 snap-start rounded-[28px] border border-line bg-panel p-6">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl font-medium">{{ card.title }}</h3>
            <span class="lp-label">{{ card.tag }}</span>
          </div>
          <p class="mt-2 text-sm text-muted">{{ card.text }}</p>
          <div class="mt-6 flex h-[190px] flex-col justify-end gap-2 rounded-2xl bg-card p-4 [background-image:radial-gradient(var(--line-2)_1px,transparent_1px)] [background-size:14px_14px]">
            <p class="max-w-[70%] self-start rounded-2xl rounded-bl-md bg-panel px-3 py-2 text-xs">On se retrouve à 18 h ?</p>
            <p class="max-w-[70%] self-end rounded-2xl rounded-br-md bg-pine px-3 py-2 text-xs text-pine-fg">Parfait, je prépare mes questions.</p>
          </div>
        </article>
      @end
    </div>
  </section>

  {{-- ===== Appel à l'action ===== --}}
  <section class="relative overflow-hidden py-28">
    <div class="pointer-events-none absolute inset-0 [background-image:radial-gradient(var(--accent)_1px,transparent_1.2px)] [background-size:16px_16px] [mask-image:radial-gradient(40%_50%_at_75%_80%,#000,transparent)] opacity-40"></div>
    <div class="relative mx-auto max-w-[900px] px-6 text-center">
      <h2 class="text-balance mb-9 text-[34px] font-medium leading-[1.12] tracking-[-0.02em] sm:text-[52px]">
        <span class="text-subtle">Rejoins</span> la conversation <span class="text-subtle">avant que</span> le groupe <span class="text-subtle">ne parte sans toi.</span>
      </h2>
      
      <div class"mt-20">
        <a class="lp-btn" href="/signup">
          Créer un compte
          @svg('lucide:arrow-right', { width: 16, height: 16 })
        </a>
      </div>  
    </div>
  </section>

  {{-- ===== FAQ ===== --}}
  <section id="faq" class="mx-auto max-w-[1180px] px-6 py-16 md:px-10">
    <h2 class="text-[40px] font-medium tracking-[-0.02em] sm:text-5xl">Questions, réponses</h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">

      <div>
        <h3 class="mb-4 font-medium">Pour démarrer</h3>
        <div class="grid gap-3">
          @each(item in [
            { q: 'Comment créer un compte ?', a: 'Renseigne ton nom, ton adresse e-mail et un mot de passe. Tu reçois ensuite un e-mail de confirmation : clique sur le lien pour activer ton compte.' },
            { q: 'Puis-je discuter à plusieurs ?', a: 'Oui. Tu peux créer un groupe, lui donner un nom et y ajouter plusieurs utilisateurs. Le créateur en est l’administrateur.' },
            { q: 'Mes messages sont-ils conservés ?', a: 'Oui. Tu retrouves tes conversations et leur historique à chaque connexion, après un rechargement de la page.' },
            { q: 'Puis-je supprimer un message ?', a: 'Oui, un message que tu as envoyé. Une indication apparaît à sa place pour signaler qu’il a été supprimé.' }
          ])
            <div class="rounded-2xl bg-card shadow-[0_1px_2px_rgba(0,0,0,0.05),0_10px_22px_-16px_rgba(0,0,0,0.25)]" x-data="{ open: false }">
              <button type="button" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-[15px]" x-on:click="open = !open" x-bind:aria-expanded="open">
                {{ item.q }}
                <span class="text-subtle transition" x-bind:class="open && 'rotate-180'">@svg('lucide:arrow-down', { width: 16, height: 16 })</span>
              </button>
              <p class="px-5 pb-5 text-sm leading-relaxed text-muted" x-show="open" x-cloak x-transition.opacity>{{ item.a }}</p>
            </div>
          @end
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-medium">Sécurité et compte</h3>
        <div class="grid gap-3">
          @each(item in [
            { q: 'Qui peut lire mes conversations ?', a: 'Seulement les membres de la conversation. L’accès est vérifié à chaque conversation et à chaque message.' },
            { q: 'Comment réinitialiser mon mot de passe ?', a: 'Sur la page de connexion, choisis « Mot de passe oublié ? ». Tu reçois un lien valable une heure pour en choisir un nouveau.' },
            { q: 'Mes mots de passe sont-ils protégés ?', a: 'Oui. Ils sont hachés avant d’être enregistrés et ne sont jamais stockés en clair. Les liens de confirmation ne servent qu’une seule fois.' },
            { q: 'Je ne reçois pas l’e-mail de confirmation.', a: 'Regarde ton dossier de courrier indésirable, puis demande un nouvel envoi depuis la page « Vérifie ta boîte mail ».' }
          ])
            <div class="rounded-2xl bg-card shadow-[0_1px_2px_rgba(0,0,0,0.05),0_10px_22px_-16px_rgba(0,0,0,0.25)]" x-data="{ open: false }">
              <button type="button" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-[15px]" x-on:click="open = !open" x-bind:aria-expanded="open">
                {{ item.q }}
                <span class="text-subtle transition" x-bind:class="open && 'rotate-180'">@svg('lucide:arrow-down', { width: 16, height: 16 })</span>
              </button>
              <p class="px-5 pb-5 text-sm leading-relaxed text-muted" x-show="open" x-cloak x-transition.opacity>{{ item.a }}</p>
            </div>
          @end
        </div>
      </div>

    </div>
  </section>

  {{-- ===== Pied de page ===== --}}
  <footer class="relative overflow-hidden border-t border-line">
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-80 [background:radial-gradient(60%_100%_at_50%_100%,var(--accent-soft),transparent_70%)]"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-80 opacity-50 [background-image:radial-gradient(var(--accent)_1px,transparent_1.2px)] [background-size:9px_9px] [mask-image:radial-gradient(60%_100%_at_50%_100%,#000,transparent_70%)]"></div>

    <div class="relative mx-auto max-w-[1180px] px-6 pb-12 pt-24 md:px-10">
      <p class="mx-auto max-w-[34rem] text-balance text-center text-2xl leading-snug">
        Kadea Chat réunit les apprenants pendant leurs projets les plus importants.
      </p>

      <div class="mt-40 grid gap-10 sm:grid-cols-2 lg:grid-cols-[auto_auto_1fr] lg:gap-20">
        <div>
          <p class="font-medium">Navigation</p>
          <ul class="mt-4 grid gap-2 text-muted">
            <li><a class="hover:text-ink" href="#fonctionnalites">Fonctionnalités</a></li>
            <li><a class="hover:text-ink" href="#comment-ca-marche">Comment ça marche</a></li>
            <li><a class="hover:text-ink" href="#faq">FAQ</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium">Compte</p>
          <ul class="mt-4 grid gap-2 text-muted">
            <li><a class="hover:text-ink" href="/signup">Créer un compte</a></li>
            <li><a class="hover:text-ink" href="/login">Se connecter</a></li>
            <li><a class="hover:text-ink" href="/forgot-password">Mot de passe oublié</a></li>
          </ul>
        </div>
        <div class="text-sm text-subtle lg:text-right">
          <p>Projet réalisé dans le cadre de la formation de Kadea Academy.</p>
          <p class="mt-2">Kadea Chat © 2026.</p>
        </div>
      </div>
    </div>
  </footer>

@end
